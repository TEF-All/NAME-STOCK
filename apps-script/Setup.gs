const SETUP_STYLE_ = { NAVY: '#0A2342', SOFT: '#50677D', YELLOW: '#FFF4D6', STRIKE: '#8899AA', TAG: '[ระบบดูแลเอง]' };
const SETUP_MIN_ROWS_ = { 'ทะเบียนพัสดุ': 2000, 'MASTER_รูป': 5000, 'STOCK_วิทยุ': 1000 };

/** สร้าง/ซ่อมแท็บตาม SHEET_SPEC_ · เขียนเฉพาะช่องที่ว่าง · คืน { made, kept, diff } */
function buildSheet_(ss) {
  const res = { made: [], kept: [], diff: [] };
  ss.setSpreadsheetTimeZone(SHEET_SPEC_.timeZone);
  try { ss.setSpreadsheetLocale(SHEET_SPEC_.locale); } catch (e) {}
  const blank = ss.getSheets().filter(function (sh) {
    return SHEET_SPEC_.tabs.every(function (t) { return t.name !== sh.getName(); }) && sh.getLastRow() === 0 && sh.getLastColumn() === 0;
  });

  SHEET_SPEC_.tabs.forEach(function (t, idx) {
    let sh = ss.getSheetByName(t.name), isNew = false;
    if (!sh) { sh = ss.insertSheet(t.name, Math.min(idx, ss.getSheets().length)); isNew = true; res.made.push(t.name); }
    else res.kept.push(t.name);

    const needCols = Math.max(t.colWidths.length, t.cells.reduce(function (m, c) { return Math.max(m, (c.startCol || 1) + c.values.length - 1); }, 1));
    if (sh.getMaxColumns() < needCols) sh.insertColumnsAfter(sh.getMaxColumns(), needCols - sh.getMaxColumns());
    const needRows = SETUP_MIN_ROWS_[t.name] || 0;
    if (needRows && sh.getMaxRows() < needRows) sh.insertRowsAfter(sh.getMaxRows(), needRows - sh.getMaxRows());

    t.cells.forEach(function (c) {
      const col = c.startCol || 1, vals = c.values.map(function (v) { return v === null ? '' : v; });
      if (!vals.length) return;
      const rg = sh.getRange(c.row, col, 1, vals.length);
      const cur = rg.getValues()[0], curF = rg.getFormulas()[0];
      const empty = cur.every(function (v, i) { return (v === '' || v === null) && !curF[i]; });
      if (empty) {
        let v = vals;
        if (c.key === 'ORG_LINE') v = [CFG.ORG + ' — ทะเบียนพัสดุและอุปกรณ์'];
        rg.setValues([v]);
      } else if (c.style === 'header') {
        const same = vals.every(function (v, i) { return String(cur[i]).trim() === String(v).trim(); });
        if (!same) res.diff.push(t.name + ' แถว ' + c.row + ' หัวตารางไม่ตรงแบบ (ไม่แก้ให้ ตรวจด้วยตัวเอง)');
      }
      setupStyle_(rg, c.style, c.row);
    });

    if (isNew) {
      t.colWidths.forEach(function (w, i) { sh.setColumnWidth(i + 1, w); });
      if (t.frozenRows) sh.setFrozenRows(t.frozenRows);
      (t.numberFormats || []).forEach(function (f) {
        const n = sh.getMaxRows() - f.fromRow + 1;
        if (n < 1) return;
        const pat = f.type === 'DATE' ? 'dd/MM/yyyy' : (f.type === 'TEXT' ? '@' : 'dd/MM/yyyy HH:mm');
        sh.getRange(f.fromRow, f.col, n, 1).setNumberFormat(pat);
      });
      (t.validations || []).forEach(function (v) {
        const rule = SpreadsheetApp.newDataValidation().requireValueInList(v.list, true).setAllowInvalid(true).build();
        sh.getRange(v.fromRow, v.col, v.toRow - v.fromRow + 1, 1).setDataValidation(rule);
      });
      if (t.conditional && t.conditional.length) {
        const rules = sh.getConditionalFormatRules();
        t.conditional.forEach(function (c) {
          const b = SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied(c.formula).setRanges([sh.getRange(c.range)]);
          if (c.format === 'strike') b.setStrikethrough(true).setFontColor(SETUP_STYLE_.STRIKE);
          else b.setBackground(SETUP_STYLE_.YELLOW);
          rules.push(b.build());
        });
        sh.setConditionalFormatRules(rules);
      }
    }
    if (t.protect) setupProtect_(sh, t.protect);
  });

  blank.forEach(function (sh) { if (ss.getSheets().length > 1) ss.deleteSheet(sh); });
  SpreadsheetApp.flush();
  return res;
}

function setupStyle_(rg, style, row) {
  if (style === 'header') {
    rg.setBackground(SETUP_STYLE_.NAVY).setFontColor('#FFFFFF').setFontWeight('bold').setVerticalAlignment('middle').setWrap(true);
    if (row === 1) rg.getSheet().setRowHeight(1, 34);
  } else if (style === 'title') rg.setFontWeight('bold').setFontSize(16).setFontColor(SETUP_STYLE_.NAVY);
  else if (style === 'subtitle') rg.setFontColor(SETUP_STYLE_.SOFT);
  else if (style === 'bold') rg.setFontWeight('bold');
  else if (style === 'bold-first') rg.getCell(1, 1).setFontWeight('bold').setFontColor(SETUP_STYLE_.NAVY);
  else if (style === 'note') rg.setFontColor(SETUP_STYLE_.SOFT).setFontStyle('italic');
}

/** ป้องกันแบบ "เตือนก่อนแก้" (แก้ได้ แต่ Google ถามยืนยัน) · ไม่ใส่ซ้ำ */
function setupProtect_(sh, kind) {
  const desc = SETUP_STYLE_.TAG + ' ' + (kind === 'header'
    ? 'หัวตาราง ห้ามลบ/แทรกคอลัมน์ (ระบบอ่านตามตำแหน่งคอลัมน์)'
    : 'แท็บนี้ระบบบันทึกเอง แก้ผ่านหน้าเว็บ');
  const type = kind === 'header' ? SpreadsheetApp.ProtectionType.RANGE : SpreadsheetApp.ProtectionType.SHEET;
  const has = sh.getProtections(type).some(function (p) { return String(p.getDescription()).indexOf(SETUP_STYLE_.TAG) === 0; });
  if (has) return;
  const p = kind === 'header' ? sh.getRange(1, 1, 1, sh.getMaxColumns()).protect() : sh.protect();
  p.setDescription(desc).setWarningOnly(true);
}

/** ① รันครั้งแรก: เตรียมชีต + ผู้ดูแลคนแรก + ตัวอุ่นระบบ (รันซ้ำได้) */
function SETUP_1_start() {
  const out = [], p = PropertiesService.getScriptProperties();
  settingsDefaults_().forEach(function (x) { out.push('ตั้งค่าเริ่มต้น ' + x); });

  let ss;
  if (!prop_('SHEET_ID')) {
    ss = SpreadsheetApp.create(CFG.APP + ' — ข้อมูล');
    const fid = prop_('DRIVE_FOLDER_ID');
    if (fid) { try { DriveApp.getFileById(ss.getId()).moveTo(DriveApp.getFolderById(fid)); } catch (e) { out.push('ย้ายชีตเข้าโฟลเดอร์ไม่สำเร็จ: ' + e.message); } }
    p.setProperty('SHEET_ID', ss.getId());
    out.push('สร้างชีตใหม่: ' + ss.getName() + ' · ' + ss.getUrl());
  } else {
    ss = SpreadsheetApp.openById(prop_('SHEET_ID'));
    out.push('ใช้ชีต: ' + ss.getName() + ' · ' + ss.getUrl());
  }

  const r = buildSheet_(ss);
  out.push('แท็บใหม่ ' + r.made.length + ' · มีอยู่แล้ว ' + r.kept.length + ' · โซนเวลาชีต ' + ss.getSpreadsheetTimeZone());
  r.diff.forEach(function (x) { out.push('⚠ ' + x); });

  const me = Session.getEffectiveUser().getEmail();
  const cur = lookupUser_(me);
  if (cur && String(cur.role).toUpperCase() === 'ADMIN') out.push('ผู้ดูแลระบบ: ' + me + ' (มีอยู่แล้ว)');
  else { SETUP_addUser(me, me.split('@')[0], 'ผู้ดูแลระบบ', 'ADMIN', 1, false); out.push('ตั้งผู้ดูแลระบบคนแรก: ' + me); }

  const pl = sheet_(CFG.TABS.PLACES);
  if (pl.getLastRow() < 2) { pl.appendRow(['P01', 'คลังหลัก', 'คลัง', '', '', 'ใช่', 'แก้ชื่อได้ที่แท็บ MASTER_สถานที่']); out.push('เพิ่มสถานที่ "คลังหลัก"'); }

  out.push('ส่งอีเมลได้อีกวันนี้ ' + MailApp.getRemainingDailyQuota() + ' ฉบับ');
  UrlFetchApp.fetch('https://oauth2.googleapis.com/tokeninfo', { method: 'post', payload: { id_token: 'x' }, muteHttpExceptions: true });
  bumpData_();
  SETUP_warmTrigger();
  out.push('ตั้งตัวอุ่นระบบทุก 5 นาทีแล้ว');
  out.push('');
  out.push('ขั้นต่อไป: Deploy > New deployment > Web app (Execute as: Me · Who has access: Anyone)');
  out.push('แล้วนำ URL ที่ลงท้าย /exec ไปใส่ใน assets/config.js (API_URL) และตั้ง Script Property FRONT_URL');
  Logger.log(out.join('\n'));
  return out;
}

/** ② ตรวจความพร้อม (อ่านอย่างเดียว) */
function SETUP_2_check() {
  const out = [], bad = [];
  const props = PropertiesService.getScriptProperties().getProperties();
  Object.keys(props).filter(function (k) { return !/^(ses_|otpday_)/.test(k); }).sort().forEach(function (k) { out.push('  ' + k + ' = ' + props[k]); });
  if (!props.SHEET_ID) bad.push('ยังไม่มี SHEET_ID → รัน SETUP_1_start');
  if (!props.FRONT_URL) bad.push('ยังไม่ได้ตั้ง FRONT_URL (ลิงก์หน้าเว็บ GitHub Pages)');
  if (props.SHEET_ID) {
    const ss = SpreadsheetApp.openById(props.SHEET_ID);
    out.push('ชีต: ' + ss.getName() + ' · โซนเวลา ' + ss.getSpreadsheetTimeZone());
    if (ss.getSpreadsheetTimeZone() !== 'Asia/Bangkok') bad.push('โซนเวลาชีตไม่ใช่ Asia/Bangkok → รัน SETUP_1_start');
    SHEET_SPEC_.tabs.forEach(function (t) { if (!ss.getSheetByName(t.name)) bad.push('ไม่มีแท็บ ' + t.name); });
    const u = ss.getSheetByName(CFG.TABS.USERS);
    const admins = u && u.getLastRow() > 1 ? u.getRange(2, 1, u.getLastRow() - 1, 7).getValues()
      .filter(function (r) { return String(r[3]).trim().toUpperCase() === 'ADMIN' && String(r[6]).trim() === 'ใช่' && String(r[0]).trim(); }).length : 0;
    out.push('ผู้ดูแลระบบที่ใช้งาน: ' + admins + ' คน');
    if (!admins) bad.push('ยังไม่มีผู้ดูแลระบบ → รัน SETUP_1_start');
  }
  let url = ''; try { url = ScriptApp.getService().getUrl() || ''; } catch (e) {}
  out.push('ลิงก์เว็บแอป (API_URL): ' + (url || '(ยังไม่ Deploy)'));
  out.push('ตัวอุ่นระบบ: ' + ScriptApp.getProjectTriggers().filter(function (t) { return t.getHandlerFunction() === 'WARM_tick'; }).length + ' ตัว');
  out.push(bad.length ? '\nยังไม่พร้อม ' + bad.length + ' ข้อ:\n- ' + bad.join('\n- ') : '\nพร้อมใช้งาน ✓');
  Logger.log(out.join('\n'));
  return { ok: !bad.length, problems: bad };
}
